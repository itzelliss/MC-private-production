####################################################################
# Condor submission for h -> aa -> mumutautau private production
#   campaign : RunIII2024Summer24
#   100 jobs x 100 events = 10000 events
####################################################################

universe                = vanilla
executable              = run_chain.sh
arguments               = $(ProcId) $ENV(MASS_H) $ENV(MASS_A) $ENV(SAMPLETAG)

environment = "RELBASE=$ENV(RELBASE) OUTBASE=$ENV(OUTBASE) MC_PRIVATE_PRODUCTION=$ENV(MC_PRIVATE_PRODUCTION)"

# Grid proxy: the DIGI step reads the premix pileup library over xrootd,
# so each job needs credentials. Refresh $HOME/x509up before submitting.
x509userproxy = $ENV(X509_USER_PROXY)
use_x509userproxy = True

# The wrapper reads CMSSW releases from AFS.
transfer_input_files    = 
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# Nothing comes back through condor — the wrapper copies MiniAOD and
# NanoAOD straight to EOS itself.
transfer_output_files   = ""

output                  = logs/$ENV(MASS_H)/$ENV(SAMPLETAG)/$ENV(MASS_A)/job_$(ProcId).out
error                   = logs/$ENV(MASS_H)/$ENV(SAMPLETAG)/$ENV(MASS_A)/job_$(ProcId).err
log                     = logs/$ENV(MASS_H)/$ENV(SAMPLETAG)/$ENV(MASS_A)/job_$(ProcId).log

# Full chain on 100 events is roughly 1.5-2.5 h. "workday" (8 h) leaves
# generous headroom; use "tomorrow" if jobs start hitting the wall.
+JobFlavour             = "workday"

request_cpus            = 1
request_memory          = 4 GB
request_disk            = 20 GB

# Retry a job up to 3 times if it exits non-zero. Transient xrootd
# failures reading the premix library are the usual cause.
max_retries             = 3

queue 1
